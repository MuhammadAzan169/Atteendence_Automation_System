# ==========================================================
# Frontend environment
# Copy this file to frontend/.env
#
# NOTE: this is a plain static site, so the browser never reads a .env file.
# This file is the documented source of truth; after changing it, mirror the
# value into frontend/js/config.js (API_BASE_URL), which the pages actually
# read. Keeping both in sync is one edit.
# ==========================================================

# Backend API base URL.
# Local (Flask serves the frontend too):  leave empty
# Production:                             https://attendance-api.onrender.com
VITE_API_BASE_URL=

# Shown in the browser tab / headings.
VITE_APP_NAME=Attendance Automation System
