# ==========================================================
# Backend environment variables
# Copy this file to backend/.env and adjust the values.
# ==========================================================

# --- Security ---------------------------------------------
# Change this in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
TOKEN_TTL_HOURS=12

# --- Database ---------------------------------------------
# Empty = bundled SQLite file (zero setup, good for local dev).
#
# For deployment, paste a PostgreSQL URL here so data survives redeploys.
# Free options that do NOT expire:
#   Supabase  https://supabase.com   (Settings > Database > Connection string)
#   Neon      https://neon.tech      (Dashboard > Connection string)
# Render's own free Postgres works too, but it expires after 30 days.
DATABASE_URL=
SQLITE_PATH=database/attendance.db

# --- CORS -------------------------------------------------
# Comma separated frontend origins allowed to call the API.
# Use * while developing; set your Vercel URL in production.
CORS_ORIGINS=*

# --- Frontend / QR ----------------------------------------
# Public URL of the deployed frontend; encoded into the company QR code.
# Exactly ONE url — it is pasted straight into the QR payload, so a comma
# separated list here produces a QR poster that scans to a broken link.
# In production set this to your Vercel URL, e.g.
#   https://attendance-system.vercel.app
FRONTEND_URL=http://localhost:5000

# Permanent identifier printed inside the company QR code. It contains no
# timestamp and no signature, so a printed poster never expires.
# Change it only when you want to invalidate posters already printed.
COMPANY_CODE=AAS-COMPANY-QR-001

# Serve frontend/ from Flask too (true = one-click local run).
# Set to false on Render, where Vercel serves the frontend.
SERVE_FRONTEND=true

# --- Server -----------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=true

# --- Attendance rules -------------------------------------
# Anyone marking after this time is recorded as "Late".
LATE_AFTER_HOUR=9
LATE_AFTER_MINUTE=0

# --- Seeded admin account ---------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
